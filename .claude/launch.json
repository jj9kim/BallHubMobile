{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "BallHub Backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--watch", "src/app.js"],
      "cwd": "backend",
      "port": 5001
    },
    {
      "name": "Expo (Mobile)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start"],
      "port": 8081
    },
    {
      "name": "Expo (Web)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "port": 8081
    }
  ]
}
